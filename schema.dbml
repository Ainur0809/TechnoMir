// ТехноМир — ER-диаграмма для dbdiagram.io
// Задание 1.1. Вставьте этот текст на https://dbdiagram.io -> Export -> картинка/ссылка для README.

Table customers {
  id            int [pk, increment]
  email         varchar [not null, unique]
  password_hash varchar [not null]
  full_name     varchar [not null]
  phone         varchar [null]
  created_at    timestamp [not null]
}

Table addresses {
  id          int [pk, increment]
  customer_id int [not null, ref: > customers.id]   // 1:N
  city        varchar [not null]
  street      varchar [not null]
  postal_code varchar
  is_default  boolean [not null, default: false]
}

Table brands {
  id              int [pk, increment]
  name            varchar [not null, unique]
  country         varchar
  warranty_months int
}

Table categories {
  id        int [pk, increment]
  name      varchar [not null]
  parent_id int [ref: > categories.id]              // self-reference, 1:N
}

Table suppliers {
  id      int [pk, increment]
  name    varchar [not null]
  email   varchar
  country varchar
}

Table products {
  id           int [pk, increment]
  name         varchar [not null]
  model        varchar
  description  text
  price        decimal [not null]
  stock        int [not null]
  power_watt   int
  energy_class varchar
  brand_id     int [not null, ref: > brands.id]      // N:1
  category_id  int [ref: > categories.id]            // N:1
  created_at   timestamp [not null]
}

Table orders {
  id          int [pk, increment]
  customer_id int [not null, ref: > customers.id]    // 1:N
  address_id  int [ref: > addresses.id]              // 1:N
  status      varchar [not null]
  total       decimal [not null]
  created_at  timestamp [not null]
}

Table order_items {
  id         int [pk, increment]
  order_id   int [not null, ref: > orders.id]        // связка N:M orders<->products
  product_id int [not null, ref: > products.id]
  quantity   int [not null]
  unit_price decimal [not null]
}

Table payments {
  id       int [pk, increment]
  order_id int [not null, ref: > orders.id]          // 1:N
  amount   decimal [not null]
  method   varchar [not null]
  status   varchar [not null]
  paid_at  timestamp [not null]
}

Table reviews {
  id          int [pk, increment]
  product_id  int [not null, ref: > products.id]
  customer_id int [not null, ref: > customers.id]
  rating      int [not null]
  comment     text
  created_at  timestamp [not null]

  indexes {
    (product_id, customer_id) [unique]               // один отзыв на товар от покупателя
  }
}

Table product_suppliers {
  product_id   int [not null, ref: > products.id]    // составной PK -> N:M
  supplier_id  int [not null, ref: > suppliers.id]
  supply_price decimal [not null]

  indexes {
    (product_id, supplier_id) [pk]
  }
}
